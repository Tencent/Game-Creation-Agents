node_modules/
.build/
Package.resolved
resources/

# macOS
.DS_Store
*.swp
*~

# IDE
.vscode/
.idea/
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.ruff_cache/
gca-mcp/.venv/
gca-mcp/uv.lock
gca-mcp/dist/
gca-mcp/build/

# Local-only ad-hoc probes; tracked regression tests live directly in gca-mcp/tests/.
gca-mcp/tests/local/

# Recordings output (generated at runtime, not source)
recordings/

# Temp files
/tmp/
*.tmp

# Claude Code per-user local settings (machine-specific; not shared)
.claude/settings.local.json

# Generated games
playground/*
!playground/CLAUDE.md


.env
.env.*
!.env.example

# API credentials (never commit)
api_keys.txt

game_test/
README.zh.md

# Sandbox secrets
sandbox.env
.claude-session/

# Vendored Playwright leaves its cwd-relative output here when MCP tools
# (run_tests / record_with_state) are tested directly
# against the gca-mcp directory instead of a real game playground.
gca-mcp/.playtest/

# `.playtest/` is a PER-GAME verification workspace (lives under playground/<game>/).
# A `.playtest/` at the repo root is always a stray (e.g. a tool run without a
# game_dir/workspace) — ignore it so it never gets committed.
/.playtest/

# Repo-level caches (env-preflight report, etc.) — generated, never source.
.cache/

# Coordination locks live at `.gca/locks/<workspace-key>/<purpose>.lock`. The
# flat `.gca-lock.*` form predates that layout; `prune_stale_locks` reclaims it.
/.gca/
.gca-lock.*

# pytest cache — generated by the test runner, never source.
.pytest_cache/

# reference
reference-code/

# TraceViewer (removed from repo)
TraceViewer/

# Internal release-prep notes (not shipped)
RELEASE_CLEANUP.md

# Local reference-review reports (not shipped)
/refereneces-improve-docs/
/references-improve-docs/

.claude/hooks/.dev_mode
